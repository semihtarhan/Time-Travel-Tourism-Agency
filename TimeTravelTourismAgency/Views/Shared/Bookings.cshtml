@using TimeTravelTourismAgency.DTOs
@model IEnumerable<BookingDtos>

@{
    ViewData["Title"] = "Rezervasyonlar";
}

<div class="py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-light mb-1">
                <i class="bi bi-journal-bookmark text-primary me-2"></i>Zaman Seyahati Rezervasyonları
            </h2>
            <p class="text-secondary mb-0">Tüm zaman sıçraması biletleri ve yolcu kayıtları.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-primary rounded-pill px-3">
            <i class="bi bi-plus-lg me-1"></i>Yeni Bilet Kes
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 border border-secondary-subtle rounded-4 bg-dark bg-opacity-25">
            <i class="bi bi-calendar-x fs-1 text-secondary"></i>
            <h5 class="text-light mt-3">Henüz Kayıtlı Rezervasyon Yok</h5>
            <p class="text-secondary small">Ana sayfadan bir destinasyon seçip bilet oluşturabilirsiniz.</p>
        </div>
    }
    else
    {
        <div class="card bg-dark border border-secondary-subtle rounded-4 overflow-hidden shadow">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="table-secondary text-uppercase small border-bottom border-secondary">
                        <tr>
                            <th class="ps-4">Rezervasyon No</th>
                            <th>Müşteri</th>
                            <th>Zaman Rotası</th>
                            <th>Yolcu Sayısı</th>
                            <th>Toplam Tutar</th>
                            <th>Tarih</th>
                            <th>Durum</th>
                            <th class="text-end pe-4">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">#@item.Id</td>
                                <td>
                                    <div class="fw-semibold text-light">@item.CustomerName</div>
                                    <div class="text-secondary small">Müşteri ID: @item.CustomerId</div>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1">
                                        <i class="bi bi-geo-alt me-1"></i>@item.DestinationTitle
                                    </span>
                                </td>
                                <td>
                                    <i class="bi bi-person me-1 text-secondary"></i>@item.PassengerCount Kişi
                                </td>
                                <td class="fw-bold text-light">
                                    @item.TotalPrice.ToString("N0") ₺
                                </td>
                                <td class="text-secondary small">
                                    @item.BookingDate.ToString("dd.MM.yyyy HH:mm")
                                </td>
                                <td>
                                    @if (item.Status == "Confirmed")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill">
                                            <i class="bi bi-check-circle me-1"></i>Onaylandı
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill">
                                            <i class="bi bi-x-circle me-1"></i>İptal Edildi
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    @if (item.Status == "Confirmed")
                                    {
                                        <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="confirmCancelReservation(@item.Id)">
                                            <i class="bi bi-x-circle me-1"></i>İptal Et
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">İşlem Yok</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function confirmCancelReservation(id) {
            const isDark = document.documentElement.getAttribute('data-bs-theme') === 'dark';

            Swal.fire({
                title: '<i class="bi bi-hourglass-split me-2 text-primary"></i>Rezervasyon İptali',
                html: `
                    <div class="text-center py-2">
                        <div class="mb-3 text-warning">
                            <i class="bi bi-exclamation-triangle fs-1"></i>
                        </div>
                        <h5 class="${isDark ? 'text-light' : 'text-dark'} mb-2">Rezervasyonu İptal Etmek İstediğinize Emin Misiniz?</h5>
                        <p class="text-secondary small">#${id} numaralı zaman sıçraması rezervasyonu iptal edilecek.</p>
                    </div>
                `,
                showCancelButton: true,
                confirmButtonText: 'Evet, İptal Et',
                cancelButtonText: 'Vazgeç',
                buttonsStyling: false,
                customClass: {
                    popup: (isDark ? 'bg-dark border border-secondary text-light' : 'bg-white border text-dark') + ' rounded-4 p-4 shadow-lg',
                    confirmButton: 'btn btn-danger rounded-pill px-4 me-2',
                    cancelButton: 'btn btn-outline-secondary rounded-pill px-4'
                },
                background: isDark ? '#161b22' : '#ffffff',
                color: isDark ? '#e6edf3' : '#212529'
            }).then((result) => {
                if (result.isConfirmed) {
                    // API'ye PUT isteği atıyoruz
                    fetch('/api/bookings/' + id + '/cancel', {
                        method: 'PUT',
                        headers: {
                            'Content-Type': 'application/json'
                        }
                    })
                    .then(response => {
                        if (response.ok) {
                            Swal.fire({
                                title: 'İptal Edildi!',
                                text: 'Rezervasyon başarıyla iptal edildi.',
                                icon: 'success',
                                timer: 1500,
                                showConfirmButton: false,
                                background: isDark ? '#161b22' : '#ffffff',
                                color: isDark ? '#e6edf3' : '#212529'
                            });

                            setTimeout(() => {
                                location.reload(); // Sayfayı yenile
                            }, 1000);
                        } else {
                            Swal.fire({
                                title: 'Hata!',
                                text: 'Rezervasyon iptal edilirken bir sorun oluştu.',
                                icon: 'error',
                                background: isDark ? '#161b22' : '#ffffff',
                                color: isDark ? '#e6edf3' : '#212529'
                            });
                        }
                    })
                    .catch(error => {
                        console.error('Hata:', error);
                    });
                }
            });
        }
    </script>
}