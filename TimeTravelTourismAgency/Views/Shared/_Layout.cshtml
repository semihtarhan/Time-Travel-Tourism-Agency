<!DOCTYPE html>
<html lang="tr" data-bs-theme="dark">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - Memories Time Travel</title>

	<!-- Bootstrap 5 CSS & İkonlar -->
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

	<link rel="icon" type="image/svg+xml" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/hourglass-split.svg" />

	<style>
				@@keyframes successPop {
						0%

		{
			transform: scale(0.5);
			opacity: 0;
		}

					70% {
			transform: scale(1.1);
			opacity: 1;
		}

					100% {
			transform: scale(1);
			opacity: 1;
		}


		}

				.animate-success {
						animation: successPop 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;

		}

					body {
							background: linear-gradient(135deg, #0d1117 0%, #161b22 100%);
							min-height: 100vh;
							color: #e6edf3;

		}

					.navbar {
							background: rgba(22, 27, 34, 0.85) !important;
							backdrop-filter: blur(10px);
							border-bottom: 1px solid #30363d;

		}

					.card-destination {
							background-color: #161b22;
							border: 1px solid #30363d;
							transition: transform 0.2s ease, box-shadow 0.2s ease;

		}

						.card-destination:hover {
								transform: translateY(-5px);
								box-shadow: 0 10px 20px rgba(13, 110, 253, 0.25);
								border-color: #0d6efd;

			}

					footer {
							border-color: #30363d !important;

		}


	</style>
</head>
<body class="d-flex flex-column min-vh-100">
	<header>
		<nav class="navbar navbar-expand-lg navbar-dark sticky-top">
			<div class="container">
				<a class="navbar-brand fw-bold text-primary" asp-controller="Home" asp-action="Index">
					<i class="bi bi-hourglass-split me-2"></i>Memories Travel
				</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>
				<div class="collapse navbar-collapse" id="navbarNav">
					<ul class="navbar-nav me-auto">
						<li class="nav-item">
							<a class="nav-link" asp-controller="Home" asp-action="Index">
								<i class="bi bi-compass me-1"></i>Zaman Rotaları
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" asp-controller="Home" asp-action="Bookings">
								<i class="bi bi-journal-bookmark me-1"></i>Rezervasyonlar
							</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" asp-controller="Admin" asp-action="Index">
								<i class="bi bi-speedometer2 me-1 text-primary"></i>Admin Paneli
							</a>
						</li>
					</ul>
					<ul class="navbar-nav ms-auto">
						@* Kullanıcı Giriş Durumu Kontrolü *@
    @if (Context.Session.GetInt32("CustomerId") != null)
    {
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle btn btn-outline-primary btn-sm px-3 text-light rounded-pill d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person-check-fill text-success"></i>
                <span>@Context.Session.GetString("CustomerName")</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark border-secondary shadow">
                <li>
                    <span class="dropdown-item-text text-secondary small">
                        Müşteri ID: #@Context.Session.GetInt32("CustomerId")
                    </span>
                </li>
                <li><hr class="dropdown-divider border-secondary"></li>
                <li>
                    <a class="dropdown-item text-danger d-flex align-items-center gap-2" asp-controller="Auth" asp-action="Logout">
                        <i class="bi bi-box-arrow-right"></i> Çıkış Yap
                    </a>
                </li>
            </ul>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="btn btn-primary btn-sm px-3 rounded-pill d-flex align-items-center gap-2" asp-controller="Auth" asp-action="Login">
                <i class="bi bi-box-arrow-in-right"></i>
                <span>Giriş Yap</span>
            </a>
        </li>
    }
					</ul>
				</div>
			</div>
		</nav>
	</header>

	<div class="container py-4 flex-grow-1">
		<main role="main">
			@RenderBody()
		</main>
	</div>

	<footer class="border-top py-3 text-secondary text-center small mt-auto">
		<div class="container">
			&copy; 2026 Memories Time Travel Agency &bull; Zamanda güvenli yolculuklar
		</div>
	</footer>

	<!-- Scriptler -->
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>