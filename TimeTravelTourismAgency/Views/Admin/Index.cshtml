@model IEnumerable<TimeTravelTourismAgency.Models.TimeDestination>

@{
    ViewData["Title"] = "Admin Paneli";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-light fw-bold">🚀 Yönetim Paneli</h2>
            <p class="text-secondary mb-0">Acente istatistikleri ve zaman rotası yönetimi.</p>
        </div>
        <button class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#createDestinationModal">
            <i class="bi bi-plus-lg me-2"></i>Yeni Rota Ekle
        </button>
    </div>

    <!-- 🔥 SWAGGER ENTEGRASYON KARTI BURAYA GELİYOR -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-dark border border-secondary rounded-4 p-4 shadow-sm d-flex flex-row align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary bg-opacity-25 text-primary p-3 rounded-circle fs-3 d-flex align-items-center justify-content-center" style="width: 55px; height: 55px;">
                        <i class="bi bi-code-slash"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold text-light mb-1">API Geliştirici Dokümantasyonu (Swagger)</h5>
                        <p class="text-secondary small mb-0">Zaman yolculuğu ve rezervasyon servis uç noktalarını inceleyin ve test edin.</p>
                    </div>
                </div>
                <div>
                    <a href="/swagger" target="_blank" class="btn btn-outline-primary px-4 rounded-pill fw-semibold d-flex align-items-center gap-2">
                        <i class="bi bi-box-arrow-up-right"></i> Swagger'ı Aç
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- İstatistik Kartları -->
    <div class="row row-cols-1 row-cols-md-4 g-4 mb-5">
        <div class="col">
            <div class="card bg-dark border border-secondary rounded-4 p-3 h-100">
                <span class="text-secondary small mb-1">Toplam Ciro</span>
                <h3 class="text-success fw-bold mb-0">@ViewBag.TotalRevenue.ToString("N0") ₺</h3>
            </div>
        </div>
        <div class="col">
            <div class="card bg-dark border border-secondary rounded-4 p-3 h-100">
                <span class="text-secondary small mb-1">Aktif Rotalar</span>
                <h3 class="text-primary fw-bold mb-0">@ViewBag.TotalDestinations</h3>
            </div>
        </div>
        <div class="col">
            <div class="card bg-dark border border-secondary rounded-4 p-3 h-100">
                <span class="text-secondary small mb-1">Toplam Rezervasyon</span>
                <h3 class="text-info fw-bold mb-0">@ViewBag.TotalBookings</h3>
            </div>
        </div>
        <div class="col">
            <div class="card bg-dark border border-secondary rounded-4 p-3 h-100">
                <span class="text-secondary small mb-1">Kayıtlı Müşteriler</span>
                <h3 class="text-warning fw-bold mb-0">@ViewBag.TotalCustomers</h3>
            </div>
        </div>
    </div>

    <!-- Rota Listesi Tablosu -->
    <div class="card bg-dark border border-secondary rounded-4 overflow-hidden">
        <div class="card-header border-secondary bg-black p-3">
            <h5 class="text-light mb-0"><i class="bi bi-map me-2"></i>Kayıtlı Zaman Rotaları</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Başlık</th>
                        <th>Yıl</th>
                        <th>Fiyat</th>
                        <th>Kontenjan</th>
                        <th>Risk</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-secondary py-4">Henüz kayıtlı rota bulunmuyor.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-light">@item.Title</td>
                                <td><span class="badge bg-secondary-subtle text-light">@item.TargetYear</span></td>
                                <td class="text-success fw-bold">@item.Price.ToString("N0") ₺</td>
                                <td>@item.Capacity</td>
                                <td>@item.DangerLevel / 5</td>

                                <td class="text-end pe-4">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <!-- 🚀 YENİ: Sadece bu rotanın rezervasyonlarını gösteren buton -->
                                        <a href="@Url.Action("Bookings", "Home", new { destinationId = item.Id })" class="btn btn-outline-info btn-sm rounded-pill px-3 text-decoration-none">
                                            <i class="bi bi-journal-bookmark me-1"></i> Rezervasyonlar
                                        </a>

                                        <!-- Mevcut Sil Butonun -->
                                        <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="confirmDelete('@item.Id', '@item.Title')">
                                            <i class="bi bi-trash me-1"></i> Sil
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Yeni Rota Ekleme Modalı -->
<div class="modal fade" id="createDestinationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border border-secondary">
            <form asp-action="CreateDestination" method="post">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-light"><i class="bi bi-plus-circle me-2"></i>Yeni Zaman Rotası Ekle</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-light small">Rota Başlığı</label>
                        <input type="text" name="Title" class="form-control bg-black text-light border-secondary" required placeholder="Örn: Antik Roma">
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-light small">Açıklama</label>
                        <textarea name="Description" class="form-control bg-black text-light border-secondary" rows="3" required placeholder="Rota detayları..."></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-light small">Hedef Yıl</label>
                            <input type="text" name="TargetYear" class="form-control bg-black text-light border-secondary" required placeholder="Örn: 79 milattan önce">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-light small">Fiyat (₺)</label>
                            <input type="number" name="Price" class="form-control bg-black text-light border-secondary" required placeholder="15000">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-light small">Kontenjan</label>
                            <input type="number" name="Capacity" class="form-control bg-black text-light border-secondary" required value="20">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-light small">Tehlike Seviyesi (1-5)</label>
                            <input type="number" name="DangerLevel" class="form-control bg-black text-light border-secondary" min="1" max="5" required value="2">
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // 1. Mevcut Silme Onay Fonksiyonun
                async function confirmDelete(id, title) {
            const result = await Swal.fire({
                title: '<i class="bi bi-hourglass-split me-2"></i>' + title,
                html: `
                    <div class="text-center py-2">
                        <div class="mb-3 text-warning">
                            <i class="bi bi-exclamation-triangle fs-1"></i>
                        </div>
                        <h5 class="text-light mb-2">Rotayı Silmek İstediğinize Emin Misiniz?</h5>
                        <p class="text-secondary small">Bu işlem geri alınamaz ve bu zamana ait tüm veriler silinecektir.</p>
                    </div>
                `,
                showCancelButton: true,
                confirmButtonText: 'Evet, Sil',
                cancelButtonText: 'Kapat',
                buttonsStyling: false,
                customClass: {
                    popup: 'bg-dark border border-secondary text-light rounded-4 p-4',
                    confirmButton: 'btn btn-danger rounded-pill px-4 me-2',
                    cancelButton: 'btn btn-outline-secondary rounded-pill px-4'
                },
                background: '#161b22',
                color: '#e6edf3'
            });

            if (result.isConfirmed) {
                try {
                    const response = await fetch(`/api/TimeDestinations/${id}`, {
                        method: 'DELETE'
                    });

                    if (!response.ok) {
                        throw new Error("Rota silinemedi! Bu rotaya ait aktif veya geçmiş rezervasyonlar olabilir.");
                    }

                    await Swal.fire({
                        title: 'Silindi!',
                        text: 'Zaman rotası başarıyla silindi.',
                        icon: 'success',
                        timer: 1200,
                        showConfirmButton: false,
                        background: '#161b22',
                        color: '#e6edf3'
                    });

                    location.reload(); // Sayfayı yenileyerek güncel listeyi getirir
                } catch (error) {
                    Swal.fire({
                        title: 'Silinemedi!',
                        text: error.message,
                        icon: 'error',
                        background: '#161b22',
                        color: '#e6edf3'
                    });
                }
            }
        }

        // 🚀 2. YENİ: Sadece tıklanan rotaya ait rezervasyonları gösteren fonksiyon
        async function showDestinationBookings(destinationId, destinationTitle) {
            Swal.fire({
                title: 'Yükleniyor...',
                text: destinationTitle + ' rezervasyonları getiriliyor.',
                allowOutsideClick: false,
                background: '#161b22',
                color: '#e6edf3',
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            try {
                const response = await fetch('/api/Bookings');
                if (!response.ok) throw new Error('Rezervasyonlar alınamadı.');

                const allBookings = await response.json();

                // Sadece seçilen rotanın ID'sine sahip rezervasyonları filtrele
                const filtered = allBookings.filter(b => b.timeDestinationId == destinationId);

                let htmlContent = '';
                if (filtered.length === 0) {
                    htmlContent = `<p class="text-secondary my-3">Bu rota için henüz kayıtlı bir rezervasyon bulunmuyor.</p>`;
                } else {
                    htmlContent = `
                        <div class="table-responsive text-start mt-3">
                            <table class="table table-dark table-sm table-borderless align-middle mb-0">
                                <thead class="border-bottom border-secondary text-secondary small">
                                    <tr>
                                        <th>Müşteri ID</th>
                                        <th>Yolcu Sayısı</th>
                                        <th class="text-end">Toplam Tutar</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    ${filtered.map(b => `
                                        <tr class="border-bottom border-secondary-subtle">
                                            <td>Müşteri #${b.customerId}</td>
                                            <td>${b.passengerCount} Kişi</td>
                                            <td class="text-end text-success fw-semibold">${Number(b.totalPrice).toLocaleString('tr-TR')} ₺</td>
                                        </tr>
                                    `).join('')}
                                </tbody>
                            </table>
                        </div>
                    `;
                }

                Swal.fire({
                    title: `<i class="bi bi-journal-bookmark text-info me-2"></i>${destinationTitle} Rezervasyonları`,
                    html: htmlContent,
                    confirmButtonText: 'Kapat',
                    buttonsStyling: false,
                    customClass: {
                        popup: 'bg-dark border border-secondary text-light rounded-4 p-4',
                        confirmButton: 'btn btn-outline-light rounded-pill px-4 mt-2'
                    },
                    background: '#161b22',
                    color: '#e6edf3'
                });

            } catch (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Hata!',
                    text: error.message,
                    background: '#161b22',
                    color: '#e6edf3'
                });
            }
        }
    </script>
}