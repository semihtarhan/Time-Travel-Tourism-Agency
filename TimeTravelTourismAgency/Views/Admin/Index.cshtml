@model IEnumerable<TimeTravelTourismAgency.Models.TimeDestination>

@{
    ViewData["Title"] = "Admin Paneli";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-light fw-bold">🚀 Yönetim Paneli</h2>
            <p class="text-secondary mb-0">Acente istatistikleri ve zaman rotası yönetimi.</p>
        </div>
        <button class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#createDestinationModal">
            <i class="bi bi-plus-lg me-2"></i>Yeni Rota Ekle
        </button>
    </div>

    <!-- İstatistik Kartları -->
    <div class="row row-cols-1 row-cols-md-4 g-4 mb-5">
        <div class="col">
            <div class="card bg-dark border border-secondary rounded-4 p-3 h-100">
                <span class="text-secondary small mb-1">Toplam Ciro</span>
                <h3 class="text-success fw-bold mb-0">@ViewBag.TotalRevenue.ToString("N0") ₺</h3>
            </div>
        </div>
        <div class="col">
            <div class="card bg-dark border border-secondary rounded-4 p-3 h-100">
                <span class="text-secondary small mb-1">Aktif Rotalar</span>
                <h3 class="text-primary fw-bold mb-0">@ViewBag.TotalDestinations</h3>
            </div>
        </div>
        <div class="col">
            <div class="card bg-dark border border-secondary rounded-4 p-3 h-100">
                <span class="text-secondary small mb-1">Toplam Rezervasyon</span>
                <h3 class="text-info fw-bold mb-0">@ViewBag.TotalBookings</h3>
            </div>
        </div>
        <div class="col">
            <div class="card bg-dark border border-secondary rounded-4 p-3 h-100">
                <span class="text-secondary small mb-1">Kayıtlı Müşteriler</span>
                <h3 class="text-warning fw-bold mb-0">@ViewBag.TotalCustomers</h3>
            </div>
        </div>
    </div>

    <!-- Rota Listesi Tablosu -->
    <div class="card bg-dark border border-secondary rounded-4 overflow-hidden">
        <div class="card-header border-secondary bg-black p-3">
            <h5 class="text-light mb-0"><i class="bi bi-map me-2"></i>Kayıtlı Zaman Rotaları</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Başlık</th>
                        <th>Yıl</th>
                        <th>Fiyat</th>
                        <th>Kontenjan</th>
                        <th>Risk</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-secondary py-4">Henüz kayıtlı rota bulunmuyor.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-light">@item.Title</td>
                                <td><span class="badge bg-secondary-subtle text-light">@item.TargetYear</span></td>
                                <td class="text-success fw-bold">@item.Price.ToString("N0") ₺</td>
                                <td>@item.Capacity</td>
                                <td>@item.DangerLevel / 5</td>
                                <td class="text-end pe-4">
                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="confirmDelete('@item.Id', '@item.Title')">
                                        <i class="bi bi-trash me-1"></i>Sil
                                    </button>

                                    <!-- Gizli Silme Formu -->
                                    <form id="delete-form-@item.Id" asp-action="DeleteDestination" asp-route-id="@item.Id" method="post" class="d-none"></form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Yeni Rota Ekleme Modalı -->
<div class="modal fade" id="createDestinationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border border-secondary">
            <form asp-action="CreateDestination" method="post">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-light"><i class="bi bi-plus-circle me-2"></i>Yeni Zaman Rotası Ekle</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label text-light small">Rota Başlığı</label>
                        <input type="text" name="Title" class="form-control bg-black text-light border-secondary" required placeholder="Örn: Antik Roma">
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-light small">Açıklama</label>
                        <textarea name="Description" class="form-control bg-black text-light border-secondary" rows="3" required placeholder="Rota detayları..."></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-light small">Hedef Yıl</label>
                            <input type="text" name="TargetYear" class="form-control bg-black text-light border-secondary" required placeholder="Örn: 79 milattan önce">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-light small">Fiyat (₺)</label>
                            <input type="number" name="Price" class="form-control bg-black text-light border-secondary" required placeholder="15000">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-light small">Kontenjan</label>
                            <input type="number" name="Capacity" class="form-control bg-black text-light border-secondary" required value="20">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-light small">Tehlike Seviyesi (1-5)</label>
                            <input type="number" name="DangerLevel" class="form-control bg-black text-light border-secondary" min="1" max="5" required value="2">
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary rounded-pill" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function confirmDelete(id, title) {
            Swal.fire({
                title: '<i class="bi bi-hourglass-split me-2"></i>' + title,
                html: `
                    <div class="text-center py-2">
                        <div class="mb-3 text-warning">
                            <i class="bi bi-exclamation-triangle fs-1"></i>
                        </div>
                        <h5 class="text-light mb-2">Rotayı Silmek İstediğinize Emin Misiniz?</h5>
                        <p class="text-secondary small">Bu işlem geri alınamaz ve bu zamana ait tüm veriler silinecektir.</p>
                    </div>
                `,
                showCancelButton: true,
                confirmButtonText: 'Evet, Sil',
                cancelButtonText: 'Kapat',
                buttonsStyling: false,
                customClass: {
                    popup: 'bg-dark border border-secondary text-light rounded-4 p-4',
                    confirmButton: 'btn btn-danger rounded-pill px-4 me-2',
                    cancelButton: 'btn btn-outline-secondary rounded-pill px-4'
                },
                background: '#161b22',
                color: '#e6edf3'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Silindi bildirimi gösterip formu gönderiyoruz
                    Swal.fire({
                        title: 'Silindi!',
                        text: 'Zaman rotası başarıyla silindi.',
                        icon: 'success',
                        timer: 1500,
                        showConfirmButton: false,
                        background: '#161b22',
                        color: '#e6edf3'
                    });

                    setTimeout(() => {
                        document.getElementById('delete-form-' + id).submit();
                    }, 1000);
                }
            });
        }
    </script>
}