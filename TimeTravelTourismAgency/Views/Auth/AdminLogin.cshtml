@{
    ViewData["Title"] = "Admin Girişi";
}

<div class="container py-5 d-flex justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="card bg-dark border border-secondary text-light rounded-4 p-4 shadow-lg" style="width: 100%; max-width: 420px;">
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-25 text-danger rounded-circle p-3 mb-2">
                <i class="bi bi-shield-lock-fill fs-1"></i>
            </div>
            <h3 class="fw-bold mb-1">Admin Paneli</h3>
            <p class="text-secondary small">Yönetim paneline erişmek için giriş yapın.</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3">
                <i class="bi bi-exclamation-triangle me-2"></i>@ViewBag.Error
            </div>
        }

        <form asp-action="AdminLogin" method="post">
            <div class="mb-3">
                <label class="form-label text-secondary small">Kullanıcı Adı</label>
                <div class="input-group">
                    <span class="input-group-text bg-black border-secondary text-secondary">
                        <i class="bi bi-person"></i>
                    </span>
                    <input type="text" name="username" class="form-control bg-black border-secondary text-light" placeholder="admin" required />
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label text-secondary small">Şifre</label>
                <div class="input-group">
                    <span class="input-group-text bg-black border-secondary text-secondary">
                        <i class="bi bi-key"></i>
                    </span>
                    <input type="password" name="password" class="form-control bg-black border-secondary text-light" placeholder="••••••" required />
                </div>
            </div>

            <button type="submit" class="btn btn-danger w-100 rounded-pill py-2 fw-semibold">
                Admin Girişi Yap
            </button>
        </form>
    </div>
</div> 